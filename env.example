# Derived T3DS point clouds: train/test/{partial,gt,gt_missing}/11/<case>/...
export DENTAL_DATA_ROOT=/absolute/path/to/t3ds_completion

# Three SCC PNGs: train/test/partial/11/<case>/<view>_{-y,y,z}.png
export DENTAL_SCC_ROOT=/absolute/path/to/t3ds_scc_views

# Required only for frozen-DINO predictor training and cache generation.
export DINO_V3_CHECKPOINT=/absolute/path/to/vit_large_patch16_dinov3.safetensors

# DINO per-view token cache used only while training C-VGP.
export DINO_REFERENCE_ROOT=/absolute/path/to/dino_reference_tokens

# Deployment prototypes exported by DINO-VGP and C-VGP.
export DINO_PROTOTYPE_ROOT=/absolute/path/to/dino_vgp_prototypes
export CVGP_PROTOTYPE_ROOT=/absolute/path/to/c_vgp_prototypes

# Legacy variable consumed by the supplied compatibility configuration.
export LITEDINO_PROTOTYPE_ROOT="$CVGP_PROTOTYPE_ROOT"
